CM_ BO_ 2365445683 "Left Joystick - J1939 Basic Joystick Message 1 (From VSC). Manual sec 8.2.1, real CAN ID 0x0CFDD633, ~16 Hz.";
CM_ BO_ 2365445939 "Left Joystick - J1939 Extended Joystick Message 1 (From VSC), Z axis only. Manual sec 8.2.2, real CAN ID 0x0CFDD733, ~16 Hz.";
CM_ BO_ 2365446196 "Right Joystick - J1939 Basic Joystick Message 2 (From VSC). Manual sec 8.2.3, real CAN ID 0x0CFDD834, ~16 Hz. NOTE: manual does not define an explicit bit layout for the numbered buttons (1-4) on this message; Button1-4Status are modeled by analogy to the documented D-Pad status layout (Table 47/48) and should be verified against a live capture.";
CM_ BO_ 2365446452 "Right Joystick - J1939 Extended Joystick Message 2 (From VSC), Z axis only. Manual sec 8.2.4, real CAN ID 0x0CFDD934, ~16 Hz.";
CM_ BO_ 2365450241 "Heartbeat - J1939 Custom Message (From VSC). Manual sec 8.2.6, real CAN ID 0x0CFDE801, 10 Hz.";
CM_ BO_ 2365450337 "Remote Status - J1939 Custom Message (From VSC). Manual sec 8.2.5, real CAN ID 0x0CFDE861, 1 Hz. Bytes 4-5 reserved, bytes 6-7 always 0x00 (not modeled as signals).";
CM_ BO_ 2365450496 "User Feedback Value - J1939 Custom Message (To VSC). Manual sec 8.2.7, real CAN ID 0x0CFDE900, aperiodic max 10 Hz.";
CM_ BO_ 2365450752 "User Feedback String - J1939 Custom Message (To VSC). Manual sec 8.2.8, real CAN ID 0x0CFDEA00, aperiodic max 10 Hz. StringChars is 6 raw ASCII characters packed big-endian-in-payload; decode byte-by-byte in application code rather than relying on the raw integer value.";

CM_ SG_ 2365445683 LeftX_Magnitude "10-bit raw joystick magnitude (0-1023). Direction/validity given by the paired NeutralStatus/NegativeStatus/PositiveStatus signals, not by sign.";
CM_ SG_ 2365445683 LeftX_NeutralStatus "0=NotSet 1=Set 2=Error 3=Unavailable. When Set, axis is centered and Magnitude should be ignored.";
CM_ SG_ 2365445683 LeftX_NegativeStatus "0=NotSet 1=Set 2=Error 3=Unavailable. When Set, Magnitude represents a negative-direction deflection.";
CM_ SG_ 2365445683 LeftX_PositiveStatus "0=NotSet 1=Set 2=Error 3=Unavailable. When Set, Magnitude represents a positive-direction deflection.";
CM_ SG_ 2365450241 VSCMode "See Table 12 in manual: 0x04=Local 0x06=Remote 0x09=Operational 0x0A=Menu 0x0B=Pause.";
CM_ SG_ 2365450241 AutonomyMode "0=User Control 1=Shared Control 2=Autonomous Control.";
CM_ SG_ 2365450241 EStopIndication "0=OK, >0=E-Stop Active. Each bit represents a distinct E-Stop source.";
CM_ SG_ 2365450337 ConnectionStrengthVSC "0=Low(intermittent, possibly disconnected) 1=Medium 2=High.";

VAL_TABLE_ VSC_JoystickStatus 3 "Unavailable" 2 "Error" 1 "Set" 0 "NotSet";
VAL_TABLE_ VSC_AutonomyModeTable 2 "AutonomousControl" 1 "SharedControl" 0 "UserControl";
VAL_TABLE_ VSC_ModeTable 11 "Pause" 10 "Menu" 9 "Operational" 6 "Remote" 4 "Local";

